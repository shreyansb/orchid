<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.orchid.watcher</string>
  <key>ProgramArguments</key><array>
    <string>__PYTHON__</string><string>-I</string>
    <string>__SCRIPT__</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>__PATH__</string>
    <key>ORCHID_CONFIG</key><string>__CONFIG__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__LOG__</string>
  <key>StandardErrorPath</key><string>__LOG__</string>
</dict></plist>
